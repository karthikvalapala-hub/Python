def extract_schema_objects(command_text):

    if not command_text:

        return []

    sql_text = _normalize_sql_for_parsing(command_text)

    cte_names = _extract_cte_names(sql_text)

    found = set()

    patterns = [

        ...

    ]

    # =====================================================

    # EXISTING REGEX LOOP

    # =====================================================

    for pattern in patterns:

        matches = re.findall(

            pattern,

            sql_text,

            flags=re.IGNORECASE | re.VERBOSE

        )

        for schema_name, object_name in matches:

            schema_name = schema_name.strip()

            object_name = object_name.strip()

            if schema_name.startswith("#") or object_name.startswith("#"):

                continue

            if object_name.lower() in cte_names:

                continue

            found.add((schema_name, object_name))

    # =====================================================

    # ADD NEW BLOCK HERE

    # =====================================================

    from_blocks = re.findall(

        r"\bfrom\b(.*?)(?:\bwhere\b|\bgroup\b|\border\b|\bhaving\b|$)",

        sql_text,

        flags=re.IGNORECASE | re.DOTALL

    )

    for block in from_blocks:

        table_matches = re.findall(

            r"(?:\[?[\w]+\]?\.)?\[?([\w]+)\]?\.\[?([\w]+)\]?",

            block,

            flags=re.IGNORECASE

        )

        for schema_name, object_name in table_matches:

            schema_name = schema_name.strip()

            object_name = object_name.strip()

            # Ignore temp tables

            if schema_name.startswith("#") or object_name.startswith("#"):

                continue

            # Ignore CTE aliases

            if object_name.lower() in cte_names:

                continue

            found.add((schema_name, object_name))

    # =====================================================

    # EXISTING RETURN

    # =====================================================

    return sorted(found
